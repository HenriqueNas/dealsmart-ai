{
  "name": "dealsmart-ai",
  "version": "0.1.0",
  "private": true,
  "author": "@henriquenas",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm migration:generate && next build",
    "dev": "pnpm services:up && ./infra/wait-for.sh localhost 5432 && pnpm migration:generate && pnpm migration:up && next dev",
    "lint:check": "eslint --fix-dry-run .",
    "lint:fix": "eslint --fix .",
    "test": "pnpm jest --runInBand",
    "test:watch": "pnpm jest --watch --runInBand",
    "services:up": "docker-compose -f infra/compose.yaml up -d",
    "services:stop": "docker-compose -f infra/compose.yaml stop",
    "services:down": "docker-compose -f infra/compose.yaml down",
    "migration:create": "prisma migrate dev --create-only --name",
    "migration:up": "prisma migrate deploy",
    "migration:generate": "prisma generate",
    "db:seed": "npx prisma db seed"
  },
  "prisma": {
    "seed": "tsx infra/prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.35",
    "@ai-sdk/openai": "^3.0.25",
    "@ai-sdk/react": "^3.0.69",
    "@anthropic-ai/sdk": "^0.72.1",
    "@auth/prisma-adapter": "^2.11.1",
    "@hubspot/api-client": "^13.4.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "ai": "^6.0.67",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "openai": "^6.17.0",
    "pg": "^8.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "20.6.2",
    "@types/pg": "^8.16.0",
    "@types/react": "18.2.21",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^2.8.8",
    "prisma": "^7.3.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.2.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
