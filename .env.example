# ----------------------------------------------------------------------------
# DATABASE (Required)
# ----------------------------------------------------------------------------
# For local development with Docker:
#   DATABASE_URL="postgresql://local_user:local_password@localhost:5432/local_db"
#
# For production (Neon, Supabase, or Vercel Postgres):
#   DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
#
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=local_db
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

DATABASE_URL="${POSTGRES_URL}"
PRISMA_DATABASE_URL=
VERCEL_OIDC_TOKEN=

# ----------------------------------------------------------------------------
# NEXTAUTH (Required for authentication)
# ----------------------------------------------------------------------------
# NEXTAUTH_URL: The canonical URL of your site
#   - Local: http://localhost:3000
#   - Production: https://your-app.vercel.app
#
# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
#
NEXTAUTH_SECRET=

# ----------------------------------------------------------------------------
# JWT TOKENS (Required for API authentication)
# generate with: openssl rand -base64 32
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ----------------------------------------------------------------------------
# HUBSPOT CRM (Optional - for CRM integration)
# ----------------------------------------------------------------------------
# Get your access token from HubSpot Developer Portal
# https://developers.hubspot.com/
#
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# HUBSPOT_ACCESS_TOKEN="" // legacy app
